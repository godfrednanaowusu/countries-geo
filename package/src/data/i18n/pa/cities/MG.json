[[0,11,21,32,38,43,48,49,52,57,73,78,80,81,105,109,122,129,133,153,155,156],["ਅੰਬਾਤੋਂਦ੍ਰਾਜਾਕਾ","ਫੇਨੋਅਰਿਵੋ ਅਤਸਿਨਾਨਾਨਾ","ਤੋਅਮਾਸਿਨਾ","ਅੰਤਸਿਰਾਨਾਨਾ","ਸੰਬਾਵਾ","ਅੰਬੋਸਿਤ੍ਰਾ","ਫਾਰਾਫਾਂਗਾਨਾ","ਫਿਆਨਾਰਾਂਤਸੋਆ","ਇਹੋਸੀ","ਮਨਾਕਾਰਾ","ਅੰਤਸੋਹਿਹੀ","ਮਾਏਵਤਨਾ","ਮਹਾਜੰਗਾ","ਮੈਂਟੀਰਾਨੋ","ਅੰਤਾਨਾਨਾਰੀਵੋ","ਅੰਤਸਿਰਾਬੇ","ਮਿਅਰਿਨਾਰਿਵੋ","ਤਸੀਰੋਨੋਮਂਡੀਡੀ","ਅੰਬੋਵੋਂਬੇ","ਮੋਰੋਂਡਾਵਾ","ਤੋਲਨਾਰੋ","ਤੋਲਿਆਰਾ"]]